{
  "name": "ytm-discord-presence",
  "version": "0.3.0",
  "private": true,
  "description": "Show the song playing on YouTube Music (Chrome) as your Discord status",
  "keywords": [
    "discord",
    "discord-rich-presence",
    "youtube-music",
    "chrome-extension",
    "native-messaging"
  ],
  "license": "MIT",
  "author": "tobsatop",
  "homepage": "https://github.com/tobsatop/discord-activity#readme",
  "bugs": "https://github.com/tobsatop/discord-activity/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobsatop/discord-activity.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/install.ts",
    "update": "node scripts/update.ts",
    "check": "tsc -p . && tsc -p extension",
    "test": "node --test --test-concurrency=1 \"host/test/*.test.ts\"",
    "icons": "node scripts/icons.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
