{
  "manifest_version": 3,
  "name": "YouTube Music → Discord",
  "version": "0.1.0",
  "description": "แสดงเพลงที่กำลังฟังบน YouTube Music ในสถานะ Discord",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Music → Discord"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page-reader.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
